{
  "$schema": "https://android-tool-suite.test/contracts/manifest-v3.schema.json",
  "format": "ats-plugin",
  "formatVersion": 3,
  "plugin": {
    "id": "gacha_analysis",
    "title": "跃迁与祈愿分析",
    "description": "获取并本地分析原神祈愿与星穹铁道跃迁记录，支持 UIGF 导入、导出和合并。",
    "version": "@VERSION_NAME@",
    "versionCode": @VERSION_CODE@,
    "minHostVersionCode": @MIN_HOST_VERSION_CODE@,
    "minAndroidApi": 26,
    "publisher": "android_tool_suite",
    "kind": "tool"
  },
  "platforms": ["android"],
  "runtime": {
    "ui": [{ "id": "main", "type": "declarative", "entry": "ui/main.json" }],
    "background": [{
      "id": "summary-worker", "type": "javascript-worker", "entry": "workers/summary.js",
      "required": true, "timeoutMs": 15000, "maxHeapBytes": 16777216
    }],
    "providers": []
  },
  "requires": {
    "plugins": [],
    "capabilities": [
      { "id": "app", "version": "^1.0.0", "optional": false, "scopes": {} },
      { "id": "storage", "version": "^1.0.0", "optional": false, "scopes": {} },
      { "id": "clipboard", "version": "^1.0.0", "optional": false, "scopes": {} },
      { "id": "file.import", "version": "^1.0.0", "optional": false, "scopes": { "mimeTypes": ["application/json", "text/plain"], "maxBytes": 33554432 } },
      { "id": "file.export", "version": "^1.0.0", "optional": false, "scopes": { "mimeTypes": ["application/json"], "maxBytes": 33554432 } },
      { "id": "scheduler", "version": "^1.0.0", "optional": false, "scopes": {} },
      {
        "id": "network.request", "version": "^1.0.0", "optional": false,
        "scopes": {
          "hosts": [
            "public-operation-hk4e.mihoyo.com", "public-operation-hk4e-sg.hoyoverse.com",
            "public-operation-hkrpg.mihoyo.com", "public-operation-hkrpg-sg.hoyoverse.com",
            "api-takumi.mihoyo.com", "api-takumi.miyoushe.com", "passport-api.mihoyo.com",
            "raw.githubusercontent.com", "starrailstation.com", "sg-public-api.hoyolab.com",
            "sg-hk4e-api-static.hoyoverse.com", "hk4e-ann-api.mihoyo.com",
            "hkrpg-ann-api.mihoyo.com", "wiki.biligame.com"
          ],
          "methods": ["GET", "POST"], "headers": ["cookie"], "maxResponseBytes": 8388608
        }
      },
      {
        "id": "system.logs", "version": "^1.0.0", "optional": true,
        "scopes": { "terms": ["auth_appid=webview_gacha", "authkey="], "maxLines": 100 }
      },
      { "id": "gacha.summary", "version": "^1.0.0", "optional": false, "scopes": {} }
    ]
  },
  "provides": { "capabilities": [{
    "id": "gacha.summary", "version": "1.0.0", "workerEntry": "summary-worker",
    "methods": ["gacha.summary.get", "gacha.summary.configure"]
  }] },
  "contributes": {
    "tools": [{ "id": "main", "uiEntry": "main" }],
    "homeWidgets": [
  {
    "id": "summary",
    "title": "抽卡单池进度",
    "template": "metric",
    "dataSource": "gacha.summary.get",
    "configurationSource": "gacha.summary.configure",
    "sizes": [
      "2x2",
      "4x2"
    ]
  },
  {
    "id": "pools",
    "title": "抽卡多池概览",
    "template": "rows",
    "dataSource": "gacha.summary.get",
    "configurationSource": "gacha.summary.configure",
    "sizes": [
      "4x2"
    ]
  },
  {
    "id": "records",
    "title": "抽卡记录概况",
    "template": "rows",
    "dataSource": "gacha.summary.get",
    "configurationSource": "gacha.summary.configure",
    "sizes": [
      "2x2",
      "4x2"
    ]
  }
]
  },
  "datasets": [
    {
      "id": "gacha-settings",
      "title": "账号选择与分析设置",
      "category": "settings",
      "formatVersion": 1,
      "sensitive": false,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 1048576,
      "restoreModes": [
        "merge",
        "replace"
      ],
      "dependsOn": [],
      "mergePolicy": {
        "format": "json",
        "rule": {
          "kind": "object",
          "fields": {
            "preferences": {
              "kind": "map",
              "items": {
                "kind": "current"
              }
            }
          }
        }
      }
    },
    {
      "id": "genshin-records",
      "title": "原神祈愿记录",
      "category": "data",
      "formatVersion": 1,
      "sensitive": false,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 268435456,
      "restoreModes": [
        "merge",
        "replace"
      ],
      "dependsOn": [],
      "mergePolicy": {
        "format": "json",
        "rule": {
          "kind": "object",
          "fields": {
            "accounts": {
              "kind": "array",
              "keys": [
                "uid"
              ],
              "items": {
                "kind": "newer",
                "timestamp": "lastSyncAt"
              }
            },
            "records": {
              "kind": "array",
              "keys": [
                "uid",
                "uigf_gacha_type|gacha_type",
                "id"
              ],
              "requireAllKeys": true,
              "aliases": {
                "uigf_gacha_type|gacha_type": {
                  "400": "301",
                  "20011": "2000",
                  "20012": "2000",
                  "20021": "2000",
                  "20022": "2000"
                }
              },
              "sortBy": "time",
              "descending": true
            },
            "poolSyncState": {
              "kind": "array",
              "keys": [
                "uid",
                "poolType"
              ],
              "items": {
                "kind": "object",
                "fields": {
                  "historyComplete": {
                    "kind": "or"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "starrail-records",
      "title": "星穹铁道跃迁记录",
      "category": "data",
      "formatVersion": 1,
      "sensitive": false,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 268435456,
      "restoreModes": [
        "merge",
        "replace"
      ],
      "dependsOn": [],
      "mergePolicy": {
        "format": "json",
        "rule": {
          "kind": "object",
          "fields": {
            "accounts": {
              "kind": "array",
              "keys": [
                "uid"
              ],
              "items": {
                "kind": "newer",
                "timestamp": "lastSyncAt"
              }
            },
            "records": {
              "kind": "array",
              "keys": [
                "uid",
                "uigf_gacha_type|gacha_type",
                "id"
              ],
              "requireAllKeys": true,
              "sortBy": "time",
              "descending": true
            },
            "poolSyncState": {
              "kind": "array",
              "keys": [
                "uid",
                "poolType"
              ],
              "items": {
                "kind": "object",
                "fields": {
                  "historyComplete": {
                    "kind": "or"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "mihoyo-session",
      "title": "米游社会话",
      "category": "secret",
      "formatVersion": 1,
      "sensitive": true,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 1048576,
      "restoreModes": [
        "merge",
        "replace"
      ],
      "dependsOn": [],
      "mergePolicy": {
        "format": "json",
        "rule": {
          "kind": "object"
        }
      }
    },
    {
      "id": "genshin-reference",
      "title": "原神公开游戏资料",
      "category": "cache",
      "formatVersion": 1,
      "sensitive": false,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 8388608,
      "restoreModes": ["replace"],
      "dependsOn": []
    },
    {
      "id": "starrail-reference",
      "title": "星铁公开游戏资料",
      "category": "cache",
      "formatVersion": 1,
      "sensitive": false,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 8388608,
      "restoreModes": ["replace"],
      "dependsOn": []
    },
    {
      "id": "record-links",
      "title": "抽卡链接缓存",
      "category": "secret",
      "formatVersion": 1,
      "sensitive": true,
      "mediaType": "application/json",
      "validator": "json",
      "maxBytes": 1048576,
      "restoreModes": [
        "merge",
        "replace"
      ],
      "dependsOn": [],
      "mergePolicy": {
        "format": "json",
        "rule": {
          "kind": "object",
          "fields": {
            "links": {
              "kind": "map",
              "items": {
                "kind": "newer",
                "timestamp": "capturedAt"
              }
            }
          }
        }
      }
    }
  ],
  "tasks": [{
    "id": "refresh-summary", "backgroundEntry": "summary-worker",
    "triggers": [{ "type": "manual" }],
    "constraints": { "network": "none", "batteryNotLow": true, "storageNotLow": true },
    "concurrency": { "policy": "replace" }, "retry": { "maxAttempts": 1, "initialBackoffMs": 10000 }
  }]
}
